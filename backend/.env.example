# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5500

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=solveit
DB_USER=root
DB_PASSWORD=root
# Or use single connection URL:
# MYSQL_URL=mysql://root:password@localhost:3306/solveit

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change_me_super_secret_jwt_key
JWT_EXPIRES_IN=24h

# --- Cloudinary (Optional for attachments) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP / Mailtrap) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SolveIt <no-reply@solveit.app>"

# --- Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Cashfree Payment Gateway ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
API_URL=http://localhost:5000
